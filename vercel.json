{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/public/landing.html"
    },
    {
      "src": "^/landing$",
      "dest": "/public/landing.html"
    },
    {
      "src": "^/studio$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/app$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
